# Optional. docker compose works without a .env file, using exactly these defaults.
# To change something, copy this file to .env and edit it.

# Database: created automatically on first start.
# Changing these later requires `docker compose down -v` (deletes the data).
DB_NAME=inventory
DB_USER=postgres
DB_PASSWORD=postgres

# Ports on your machine. The API always uses 8080.
DASHBOARD_PUBLISHED_PORT=8081
# Only for connecting a DB tool; the app itself doesn't use it.
DB_PUBLISHED_PORT=5433

# Must include the address you open the dashboard from (update it if you change the port above).
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:4200